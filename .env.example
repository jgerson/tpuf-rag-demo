# Copy to .env and fill in. Never commit the real .env (it's in .gitignore).
TURBOPUFFER_API_KEY=tpuf_...
ANTHROPIC_API_KEY=sk-ant-...        # optional: written answers with citations

# Optional overrides (defaults shown)
# TURBOPUFFER_REGION=gcp-us-central1
# NAMESPACE_PREFIX=tpragdemo
# EMBED_MODEL=nvidia/nemotron-3-embed-8b
# EMBED_DIMS=1024
# RERANK_MODEL=zeroentropy/zerank-2
# CLAUDE_MODEL=claude-sonnet-5-5
# SEMANTIC_MODEL=minishlab/potion-base-32M
# APP_PASSWORD=choose-one            # recommended if you deploy it
